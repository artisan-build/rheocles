---
// The sibling header: mark · wordmark · pronunciation in mono · Docs · GitHub.
// Identical on the landing page and every docs page. The measures are
// sonocles.com's, read off the live header in px (13 Sep 2026): 30px mark,
// 23px wordmark, 12.5px pronunciation, 14px/500 links 22px apart, 26px above
// the row and nothing below it, everything centred on one line. The type and
// the colours stay ours.
import Mark from './Mark.astro';
const path = Astro.url.pathname;
const inDocs = path === '/docs' || path.startsWith('/docs/');
---

<header class="header">
	<div class:list={['wrap', 'header__row', { 'wrap--wide': inDocs }]}>
		<a href="/" class="brand" aria-label="Rheocles home">
			<Mark class="brand__mark" size={30} color="var(--aegean)" />
			<span class="brand__name">Rheocles</span>
			<span class="brand__say">REE-oh-kleez</span>
		</a>
		<nav class="nav" aria-label="Site">
			<a href="/docs" aria-current={inDocs ? 'page' : undefined}>Docs</a>
			<a href="https://github.com/artisan-build/rheocles">GitHub →</a>
		</nav>
	</div>
</header>

<style>
	.header__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-block: 26px 0;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		text-decoration: none;
		min-width: 0;
	}
	/* The mark is Mark.astro's <svg>, outside this component's scope; its
	   colour is passed in above. */
	.brand :global(.brand__mark) {
		flex: none;
	}
	.brand__name {
		font-family: var(--display);
		font-variation-settings: 'SOFT' 30, 'WONK' 1;
		font-weight: 700;
		font-size: 23px;
		letter-spacing: -0.01em;
	}
	.brand__say {
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--ink-faint);
	}
	.nav {
		display: flex;
		gap: 22px;
		font-size: 14px;
		font-weight: 500;
	}
	/* The links carry a 2px floor, clear until hovered or current — the
	   treatment sonocles.com's header links have, in the Aegean. */
	.nav a {
		color: var(--aegean);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}
	.nav a:hover,
	.nav a[aria-current='page'] {
		border-bottom-color: var(--aegean);
	}
	@media (max-width: 480px) {
		.brand__say {
			display: none;
		}
	}
</style>
