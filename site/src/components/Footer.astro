---
import Meander from './Meander.astro';
import { version, releaseUrl } from '../lib/version';
// With build.format 'file' the docs index builds as /docs.html, and that is
// the pathname this sees; without the trim it was the one docs page that
// counted as not-docs.
const path = Astro.url.pathname.replace(/\.html$/, '');
const inDocs = path === '/docs' || path.startsWith('/docs/');
---

<footer class="footer">
	<div class:list={['wrap', { 'wrap--wide': inDocs }]}>
		<Meander />
		<p class="footer__line">
			<strong>Rheocles</strong>{version && <> <a class="footer__version" href={releaseUrl}>{version}</a></>} —
			every stream, in its own file, on one cue. Apple Silicon, macOS 15 or later.
		</p>
		<p class="footer__line">
			Free and open source under the MIT licence.{' '}
			<a href="https://github.com/artisan-build/rheocles">Source on GitHub</a>.
		</p>
		<p class="footer__line">
			Made for <a href="https://pteroprompter.com">Pteroprompter</a> by{' '}
			<strong>ProjektGopher Multimedia</strong>, an <strong>Artisan Build</strong> property.{' '}
			Useful on its own.
		</p>
	</div>
</footer>

<style>
	.footer {
		margin-top: 5rem;
		padding-bottom: 3rem;
	}
	.footer__line {
		font-size: 0.9rem;
		color: var(--ink-soft);
		margin: 0.5rem 0;
	}
	.footer__line:first-of-type {
		margin-top: 2rem;
	}
	.footer strong {
		font-weight: 600;
		color: var(--ink);
	}
	.footer__line:first-of-type strong {
		font-family: var(--display);
		font-variation-settings: 'SOFT' 30, 'WONK' 1;
		font-weight: 700;
	}
	/* The version is a fact, not a badge: mono, the line's own colour, a
	   link to that tag's release page. */
	.footer__version {
		font-family: var(--mono);
		font-size: 0.85em;
		color: inherit;
		text-decoration-color: color-mix(in oklab, var(--ink-soft) 40%, transparent);
	}
</style>
