---
// The one-cue idea, drawn: five armed streams, one cue, one file each, one of
// them joining four minutes in and stamped four minutes in. HTML and CSS so
// it reflows at phone width and the numbers are real text.
const cue = '14:02:17:00';
const lanes = [
	{ kind: 'camera', name: 'Camera · FaceTime HD', file: 'cam-facetime.mov', from: 0, stamp: cue },
	{ kind: 'display', name: 'Display · Prompter', file: 'display-prompter.mov', from: 0, stamp: cue },
	{ kind: 'mic', name: 'Microphone · SM7B', file: 'mic-sm7b.wav', from: 0, stamp: cue },
	{ kind: 'system', name: 'System audio', file: 'system-audio.wav', from: 0, stamp: cue },
	{ kind: 'window', name: 'Window · Keynote', file: 'window-keynote.mov', from: 32, stamp: '14:06:17:00', late: true },
];
---

<figure class="cue">
	<div class="cue__head">
		<span><b>take</b> ep12</span>
		<span><b>cue</b> {cue}</span>
		<span><b>stop</b> 14:14:40:12</span>
		<span><b>files</b> 5</span>
	</div>
	<div class="cue__lanes">
		{
			lanes.map((l) => (
				<div class="lane">
					<span class="lane__name">{l.name}</span>
					<div class="lane__track">
						<span class:list={['bar', { 'bar--late': l.late }]} style={`--from:${l.from}%`}>
							<span class="bar__stamp">{l.stamp}</span>
							<span class="bar__file">{l.file}</span>
						</span>
					</div>
				</div>
			))
		}
		<div class="cue__line cue__line--cue"><span>cue</span></div>
		<div class="cue__line cue__line--join"><span>+4:00 · joins</span></div>
		<div class="cue__line cue__line--stop"><span>stop</span></div>
	</div>
	<figcaption class="cue__caption">
		Each bar is one file. The stamp is the time-of-day timecode of its first written frame, so
		the late one lands at four minutes in any editor without the manifest — and the manifest
		agrees.
	</figcaption>
</figure>

<style>
	.cue {
		margin: 2.5rem 0 0;
		font-family: var(--mono);
	}
	.cue__head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.6rem;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
		margin-bottom: 1rem;
	}
	.cue__head b {
		font-weight: 500;
		text-transform: uppercase;
		color: var(--script);
		margin-right: 0.35rem;
	}
	.cue__lanes {
		position: relative;
		display: grid;
		gap: 0.55rem;
		padding-block: 1.6rem 1.4rem;
	}
	.lane {
		display: grid;
		grid-template-columns: 11.5rem minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
	}
	.lane__name {
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--ink-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.lane__track {
		position: relative;
		height: 2rem;
		background: var(--limestone-deep);
		border-radius: 6px;
	}
	.bar {
		position: absolute;
		inset: 0.3rem 0.3rem 0.3rem calc(var(--from) + 0.3rem);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding-inline: 0.55rem;
		background: var(--aegean);
		color: var(--limestone);
		border-radius: 4px;
		font-size: 0.68rem;
		overflow: hidden;
		white-space: nowrap;
	}
	.bar--late {
		background: var(--ochre);
		color: var(--ink);
	}
	.bar__file {
		opacity: 0.8;
	}
	.cue__line {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(12.5rem + (100% - 12.5rem) * var(--at) / 100);
		border-left: 1.5px dashed var(--ink-faint);
		pointer-events: none;
	}
	.cue__line span {
		position: absolute;
		top: 0;
		left: 0.4rem;
		font-size: 0.64rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
		white-space: nowrap;
	}
	.cue__line--cue {
		--at: 0;
		border-color: var(--oxide);
	}
	.cue__line--cue span {
		color: var(--oxide);
	}
	.cue__line--join {
		--at: 32;
		border-color: var(--ochre-ink);
	}
	.cue__line--join span {
		top: auto;
		bottom: 0;
		color: var(--ochre-ink);
	}
	.cue__line--stop {
		--at: 100;
		left: calc(100% - 1px);
	}
	.cue__line--stop span {
		left: auto;
		right: 0.4rem;
	}
	.cue__caption {
		font-family: var(--sans);
		font-size: 0.9rem;
		color: var(--ink-soft);
		margin-top: 0.8rem;
		max-width: 40rem;
	}
	@media (max-width: 640px) {
		.lane {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.25rem;
		}
		.lane__name {
			font-size: 0.78rem;
			position: relative;
			z-index: 1;
			width: max-content;
			max-width: 100%;
			padding-right: 0.4rem;
			background: var(--limestone);
		}
		.cue__lanes {
			gap: 0.8rem;
		}
		.cue__line {
			left: calc(100% * var(--at) / 100);
		}
		.cue__line--stop {
			left: calc(100% - 1px);
		}
		.bar__file {
			display: none;
		}
	}
</style>
