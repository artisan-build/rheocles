---
// The hero's Homebrew line: the command in a plain read-only chip, and a
// Copy button to its right — the primary button's colour, pill-shaped like
// the CTAs, the chip's height. The command lives once, in `data-cmd`; the
// script reads it from there and never repeats it.
//
// The button holds one width across its three labels (Copy, Copied, Select)
// by stacking them in one grid cell; `data-state` picks the visible one. On
// success the check draws itself; base.css already switches every animation
// off under prefers-reduced-motion, and the base styles here are the finished
// states, so reduced motion gets the plain swap for free.
//
// On a phone the button stays on the chip's row: the chip shrinks and the
// command loses its middle to an ellipsis — the head first, the tap path
// last — rather than wrapping under the button. What is copied or selected
// is always the whole command.
interface Props {
	cmd: string;
}
const { cmd } = Astro.props;
const split = cmd.lastIndexOf(' ');
const head = cmd.slice(0, split);
const tail = cmd.slice(split + 1);
---

<span class="homebrew" data-cmd={cmd}>
	<code class="homebrew__cmd" style={`--tail: ${tail.length + 1}ch`}><span class="homebrew__head">{head}</span> {tail}</code>
	<button type="button" class="homebrew__copy" aria-label="Copy the Homebrew command">
		<span class="homebrew__label homebrew__label--idle" aria-hidden="true">
			<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<rect x="5.5" y="5.5" width="8.5" height="8.5" rx="1.5" />
				<path d="M10.5 5.5V3.5a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
			</svg>
			Copy
		</span>
		<span class="homebrew__label homebrew__label--done" aria-hidden="true">
			<svg class="homebrew__check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M3 8.5l3.2 3.2L13 5" pathLength="1" />
			</svg>
			Copied
		</span>
		<span class="homebrew__label homebrew__label--fail" aria-hidden="true">Select</span>
	</button>
	<span class="homebrew__live" aria-live="polite"></span>
</span>

<script>
	const copy = async (cmd: string) => {
		try {
			await navigator.clipboard.writeText(cmd);
			return true;
		} catch {
			// No async clipboard (an insecure context, or a permission refused):
			// the old way, through a textarea the user never sees.
			const area = document.createElement('textarea');
			area.value = cmd;
			area.setAttribute('readonly', '');
			area.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
			document.body.append(area);
			area.select();
			let ok = false;
			try {
				ok = document.execCommand('copy');
			} catch {}
			area.remove();
			return ok;
		}
	};

	for (const line of document.querySelectorAll<HTMLElement>('.homebrew[data-cmd]')) {
		const cmd = line.dataset.cmd ?? '';
		const code = line.querySelector('.homebrew__cmd')!;
		const button = line.querySelector<HTMLButtonElement>('.homebrew__copy')!;
		const live = line.querySelector<HTMLElement>('.homebrew__live')!;
		let timer = 0;
		button.addEventListener('click', async () => {
			clearTimeout(timer);
			// A second click while Copied is showing restarts the draw: the
			// state has to leave and come back for the animation to.
			button.dataset.state = '';
			void button.offsetWidth;
			if (await copy(cmd)) {
				button.dataset.state = 'copied';
				live.textContent = 'Copied';
			} else {
				// The button says Select and the command is already selected:
				// Cmd-C is the rest of the job.
				button.dataset.state = 'failed';
				live.textContent = 'Copy failed — select to copy';
				const range = document.createRange();
				range.selectNodeContents(code);
				const selection = window.getSelection();
				selection?.removeAllRanges();
				selection?.addRange(range);
			}
			timer = window.setTimeout(() => {
				button.dataset.state = '';
				live.textContent = '';
			}, 1400);
		});
	}
</script>

<style>
	.homebrew {
		display: inline-flex;
		align-items: stretch;
		gap: 0.5rem;
		min-width: 0;
		max-width: 100%;
		position: relative;
	}
	/* The chip: read-only, selectable, no hover. It sheds the inline-code
	   styling of base.css and carries its own. One line, never wrapped: the
	   head is an inline-block capped at what is left beside the tap path
	   (--tail, the path's length in ch — mono, so ch is the glyph), and gives
	   way to an ellipsis first; only when it is gone does the path lose its
	   end. Inline-blocks, not flex items, so a selection of the chip reads as
	   one line. */
	.homebrew__cmd {
		display: block;
		flex: 1 1 auto;
		min-width: 0;
		padding: 0.45em 0.8em;
		border-radius: 7px;
		background: var(--limestone-deep);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 0.8rem;
		line-height: 1.55;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		user-select: all;
	}
	.homebrew__head {
		display: inline-block;
		vertical-align: top;
		max-width: calc(100% - var(--tail));
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* The button: the CTA's pill and colour at the chip's size. The three
	   labels share one cell, so its width is the widest of them and never
	   moves. */
	.homebrew__copy {
		--fill: var(--aegean);
		flex: none;
		display: inline-grid;
		align-items: center;
		margin: 0;
		padding: 0 0.95em;
		border: 0;
		border-radius: 999px;
		background: var(--fill);
		color: var(--limestone);
		font-family: var(--sans);
		font-weight: 600;
		font-size: 0.8rem;
		line-height: 1;
		cursor: pointer;
		transition: background 120ms ease-out;
	}
	.homebrew__copy:hover {
		--fill: var(--aegean-deep);
	}
	.homebrew__label {
		grid-area: 1 / 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4em;
		white-space: nowrap;
		visibility: hidden;
	}
	.homebrew__label--idle,
	.homebrew__copy[data-state='copied'] .homebrew__label--done,
	.homebrew__copy[data-state='failed'] .homebrew__label--fail {
		visibility: visible;
	}
	.homebrew__copy[data-state='copied'] .homebrew__label--idle,
	.homebrew__copy[data-state='failed'] .homebrew__label--idle {
		visibility: hidden;
	}
	.homebrew__check path {
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}
	.homebrew__copy[data-state='copied'] .homebrew__check path {
		animation: brew-draw 160ms ease-out;
	}
	@keyframes brew-draw {
		from {
			stroke-dashoffset: 1;
		}
	}

	.homebrew__live {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
