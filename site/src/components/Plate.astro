---
// An illustration, or the place one will go. Plates are generated by
// art/make.py from the prompts in site/ART.md into site/art/originals, cut
// to stickers by site/art/sticker.py — the cream removed, the drawing sat
// straight on the page — and committed under src/assets/plates; nothing is
// generated until Len approves the run. A plate without a `src` renders as a
// flat shape in the right proportions so the page rhythm is real before the
// picture is. A sticker has no box, so the image has no corners; `boxed`
// keeps them for a plate still shipping on its rectangle (one whose drawing
// touches the frame; see ART.md).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Mark from './Mark.astro';
interface Props {
	name: string;
	src?: ImageMetadata;
	alt?: string;
	ratio?: string; // CSS aspect-ratio, for the placeholder
	caption?: string;
	class?: string;
	loading?: 'lazy' | 'eager';
	boxed?: boolean;
}
const { name, src, alt = '', ratio = '3 / 2', caption, class: cls, loading = 'lazy', boxed = false } = Astro.props;
---

<figure class:list={['plate', cls]}>
	{
		src ? (
			<Image
				class:list={['plate__img', { 'plate__img--boxed': boxed }]}
				src={src}
				alt={alt}
				widths={[480, 920, 1380, src.width]}
				sizes="(max-width: 1000px) 92vw, 920px"
				format="webp"
				loading={loading}
			/>
		) : (
			<div class="plate__shape" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Illustration to come: ${name}`}>
				<Mark size={40} class="plate__mark" />
				<span class="plate__name">plate · {name}</span>
			</div>
		)
	}
	{caption && <figcaption class="plate__caption" set:html={caption} />}
</figure>

<style>
	.plate {
		margin: 2rem 0 0;
	}
	.plate__img {
		display: block;
		width: 100%;
		height: auto;
	}
	.plate__img--boxed {
		border-radius: 12px;
	}
	.plate__shape {
		width: 100%;
		max-width: 100%;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 0.8rem;
		background: var(--limestone-deep);
		border-radius: 12px;
		color: var(--aegean-soft);
	}
	.plate__name {
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--script);
	}
	.plate__caption {
		margin-top: 0.9rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
	}
	.plate__caption :global(strong) {
		color: var(--ink);
		font-weight: 600;
	}
</style>
