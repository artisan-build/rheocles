---
// The API reference, generated. Source: docs/openapi.yaml when it has paths,
// else the spec §11 table (src/lib/api-spec.ts). See src/lib/openapi.ts.
import { getCollection } from 'astro:content';
import { Code } from 'astro-expressive-code/components';
import Docs from '../../../layouts/Docs.astro';
import Endpoint from '../../../components/Endpoint.astro';
import Callout from '../../../components/Callout.astro';
import { loadApi } from '../../../lib/openapi';

const api = loadApi();
const existing = new Set((await getCollection('docs')).map((e) => e.id));
const headings = [
	{ depth: 2, slug: 'conventions', text: 'Conventions' },
	...api.groups.map((g) => ({ depth: 2, slug: g.id, text: g.label })),
	{ depth: 2, slug: 'event-types', text: 'Event types' },
];
const draft = api.source !== 'openapi';
---

<Docs
	id="api/reference"
	title="API reference"
	description={
		api.source === 'openapi'
			? `Generated from docs/openapi.yaml, version ${api.version ?? ''}. CI validates the running daemon against the same file.`
			: api.source === 'merged'
				? `Every route, on both transports. ${api.pinned} generated from docs/openapi.yaml ${api.version ? `(${api.version})` : ''}; ${api.planned} still only in the spec, marked planned.`
				: 'Every route, on both transports. Built from the spec’s endpoint table until docs/openapi.yaml lands; then generated from it.'
	}
	draft={draft}
	existing={existing}
	headings={headings}
	wide
>
	<h2 id="conventions">Conventions</h2>
	<table>
		<tbody>
			<tr><td>HTTP + SSE</td><td><code>http://127.0.0.1:7447</code></td></tr>
			<tr><td>WebSocket</td><td><code>ws://127.0.0.1:7448</code></td></tr>
			<tr><td>Auth</td><td><code>Authorization: Bearer &lt;token&gt;</code> on every HTTP request; <code>?access_token=</code> also accepted on <code>GET /events</code>; on the WebSocket, a first frame of <code>{`{ "auth": "<token>" }`}</code></td></tr>
			<tr><td>Bodies</td><td>JSON in, JSON out; <code>Content-Type: application/json</code></td></tr>
			<tr><td>Paths</td><td>the take folder is relative to <code>outputRoot</code> from <code>GET /</code>; each file is relative to the take folder</td></tr>
			<tr><td>Times</td><td>host times are ISO 8601 UTC with milliseconds; <code>t</code> is seconds from the cue; <code>timecode</code> is <code>HH:MM:SS:FF</code></td></tr>
			<tr><td>Absence</td><td>an unmeasurable value is absent, or <code>null</code> where the field is always present — never <code>0</code></td></tr>
		</tbody>
	</table>
	<Code
		code={`{ "error": "destination takes/2026-09-11/210433-episode-12 is not empty", "code": "conflict" }`}
		lang="json"
		title="the error shape — error for humans, code for programs"
	/>
	<table>
		<thead><tr><th>status</th><th>code</th><th>when</th></tr></thead>
		<tbody>
			<tr><td><code>400</code></td><td><code>bad_request</code></td><td>malformed JSON, missing body, a frame without <code>method</code>/<code>path</code></td></tr>
			<tr><td><code>401</code></td><td><code>unauthorized</code></td><td>no token, wrong token, WebSocket before the auth frame</td></tr>
			<tr><td><code>403</code></td><td><code>permission_denied</code></td><td>macOS has not granted the device class this stream needs</td></tr>
			<tr><td><code>404</code></td><td><code>not_found</code></td><td>no such route, stream or take</td></tr>
			<tr><td><code>405</code></td><td><code>method_not_allowed</code></td><td>the path exists, the method does not</td></tr>
			<tr><td><code>409</code></td><td><code>conflict</code></td><td>destination already exists; a take is not in the state the verb needs</td></tr>
			<tr><td><code>409</code></td><td><code>take_active</code></td><td>a take is recording; stop it first</td></tr>
			<tr><td><code>500</code></td><td><code>internal</code></td><td>a handler threw</td></tr>
			<tr><td><code>501</code></td><td><code>unsupported</code></td><td>this kind cannot be captured yet</td></tr>
			<tr><td><code>503</code></td><td><code>device_unavailable</code></td><td>the device is gone, busy, or refused the configuration</td></tr>
			<tr><td><code>507</code></td><td><code>insufficient_storage</code></td><td>the disk pre-flight refused the take</td></tr>
		</tbody>
	</table>
	{
		draft && (
			<Callout kind="note" title="Where this comes from">
				Routes marked <b>pinned</b> are generated from <code>docs/openapi.yaml</code>, which CI
				validates against the running daemon. Routes marked <b>planned</b> are from the spec's
				endpoint table and change here before they change in the code; each becomes pinned as
				the YAML gains it, and this banner goes when the last one does.
			</Callout>
		)
	}

	{
		api.groups.map((g) => (
			<>
				<h2 id={g.id}>{g.label}</h2>
				{g.blurb && <p class="blurb">{g.blurb}</p>}
				{g.endpoints.map((e) => (
					<Endpoint endpoint={e} />
				))}
			</>
		))
	}

	<h2 id="event-types">Event types</h2>
	<p class="blurb">
		Delivered on <code>GET /events</code> as <code>data:</code> lines, and on the WebSocket as
		objects with an <code>event</code> key and no <code>id</code>. Shapes are planned until the
		YAML pins them.
	</p>
	<table>
		<thead><tr><th>event</th><th>when</th><th>data</th></tr></thead>
		<tbody>
			{
				api.events.map((ev) => (
					<tr>
						<td><code>{ev.type}</code>{ev.pinned && <span class="badge badge--pinned">pinned</span>}{ev.planned && <span class="badge badge--planned">planned</span>}</td>
						<td>{ev.when}</td>
						<td><code class="ex">{ev.example}</code></td>
					</tr>
				))
			}
		</tbody>
	</table>
</Docs>

<style>
	.blurb {
		color: var(--ink-soft);
		margin-bottom: 0.6rem;
	}
	.badge {
		display: inline-block;
		font-family: var(--mono);
		font-size: 0.6rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.15em 0.5em;
		border-radius: 999px;
		margin-left: 0.5rem;
		vertical-align: middle;
	}
	.badge--pinned {
		color: var(--olive);
		border: 1px solid var(--olive);
	}
	.badge--planned {
		color: var(--script);
		border: 1px solid var(--limestone-line);
	}
	code.ex {
		font-size: 0.74em;
		white-space: pre-wrap;
		background: transparent;
		padding: 0;
	}
</style>
