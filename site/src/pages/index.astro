---
// The landing page, per docs/BRAND.md and the approved IA. Illustrations are
// placeholders until the runs in site/ART.md are approved.
import { Code } from 'astro-expressive-code/components';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Plate from '../components/Plate.astro';
import CueDiagram from '../components/CueDiagram.astro';
import { Image } from 'astro:assets';
import { version, releaseUrl } from '../lib/version';
import heroPlate from '../assets/plates/hero.png';
import stonePlate from '../assets/plates/stone.png';
import rigPlate from '../assets/plates/rig.png';
// The real popover, rendered by the app itself — site/ART.md § Screenshots.
import popover from '../assets/popover.png';

const manifest = `{
  "id": "20260911T210217-fd9q", "name": "Episode 12", "state": "recording",
  "created": "2026-09-11T21:02:09.412Z", "started": "2026-09-11T21:02:17.004Z",
  "outputRoot": "/Users/len/Movies/Rheocles",
  "destination": "takes/2026-09-11/140217-episode-12",
  "streams": [
    { "id": "camera:0x2300000fd9009c", "kind": "camera", "name": "Elgato 4K X",
      "path": "elgato-4k-x.mov", "codec": "hevc",
      "started": "2026-09-11T21:02:17.004Z", "timecode": "14:02:17:00",
      "framesWritten": 21540, "events": [ { "t": 0, "type": "join" } ] },
    { "id": "window:11597", "kind": "window", "name": "Keynote",
      "path": "window-com.apple.iWork.Keynote.mov", "codec": "hevc",
      "started": "2026-09-11T21:06:17.021Z", "timecode": "14:06:17:00",
      "framesWritten": 7200, "events": [ { "t": 240.017, "type": "join" } ] }
  ],
  "markers": [ { "t": 38.7, "label": "cold-open out" } ],
  "settings": { "codec": "hevc", "expectedDuration": 1800 }
}`;

const api = `TOKEN="$(cat ~/Library/Application\\ Support/Rheocles/token)"
H="Authorization: Bearer $TOKEN"

curl -s -H "$H" -X POST localhost:7447/takes -d '{"name":"Episode 12"}'
#   → 201, the manifest: id, destination, a path per stream. Nothing is recording.

T=localhost:7447/takes/20260911T210217-fd9q
curl -s -H "$H" -X POST $T/start                                  # the cue
curl -s -H "$H" -X POST $T/markers -d '{"label":"cold-open out"}'
curl -s -H "$H" -X POST $T/stop`;

const events = `// the same command set, both transports live at once
const es = new EventSource('http://127.0.0.1:7447/events')   // SSE
const ws = new WebSocket('ws://127.0.0.1:7448/')             // full duplex`;
---

<Base
	title="Rheocles — every stream, in its own file, on one cue"
	description="Rheocles records the cameras, microphones, displays and windows you choose, all at once — each in its own file, started on one cue and stamped with time-of-day timecode. Free, open source, MIT."
	card={{
		alt: 'Rhea, in a blue Minoan dress, stands behind a bench of six cradles with one finger raised to count in, while Kronos sulks in a doorway. Every stream, in its own file, on one cue.',
		twitterDescription: 'Every camera, mic, display and window you choose — each in its own file, time-of-day timecode in every one. Free, open source, MIT.',
	}}
>
	{/* Copy left, the popover right; on a phone the popover drops in after
	    the first paragraph so something visual is above the fold there too.
	    Every child is a sibling for that reason — the order is CSS. */}
	<section class="hero wrap">
		<p class="pill">Free · Open source · MIT</p>
		<h1 class="hero__title">
			Every stream, in its own file,<br />
			<span class="hero__accent">on one cue.</span>
		</h1>
		<p class="hero__stand hero__stand--first">
			Rheocles records the cameras, microphones, displays and windows <strong>you choose</strong>,
			all at once — each in its own file, started on one cue and stamped
			with <strong>time-of-day timecode</strong>, so they line up in your editor in one click.
		</p>
		<Image
			class="hero__popover"
			src={popover}
			width={344}
			densities={[1, 2]}
			format="png"
			loading="eager"
			alt="The Rheocles menu bar popover. Displays, windows, cameras and microphones are listed with a switch each; the Elgato 4K X camera and the Scarlett 2i2 microphone are armed, the BenQ display and two windows are listed but not. The take bar is idle: a Record button, a take name field, and an unticked Also save a single file."
		/>
		<p class="hero__stand">
			<strong>Separate files for your edit, or one file to send straight away — you choose per
			take.</strong> Arm what you might want, cue once, cut later.
		</p>
		<p class="hero__note">
			Local only (for now). An HTTP and WebSocket API, one bearer token, zero clicks to pair.
		</p>
		<div class="hero__actions">
			<a class="button button--primary" href="https://github.com/artisan-build/rheocles/releases/latest/download/Rheocles.dmg">Download for Mac</a>
			<a class="button" href="/docs">Read the docs</a>
			<a class="button" href="https://github.com/artisan-build/rheocles">Source on GitHub</a>
			<span class="hero__platform">
				{version && <><a href={releaseUrl}>v{version}</a> · </>}Apple Silicon · macOS 15 or later
			</span>
		</div>
		<p class="hero__brew">
			<span>or</span>
			<code><span>brew install --cask</span> <span>artisan-build/tap/rheocles</span></code>
		</p>
	</section>

	<div class="wrap">
		<Plate
			name="Rhea and the cradles"
			src={heroPlate}
			loading="eager"
			alt="Rhea, in a blue flounced dress, stands behind a bench of six cradles with one finger raised to count in; six infants watch her hand. Kronos sulks, arms folded, in a doorway at the left."
			caption="<strong>The whole product, basically.</strong> Six children, six cradles, one hand raised. Nobody gets swallowed."
		/>
		<CueDiagram />
	</div>

	<Section kicker="Why it exists">
		<h2>OBS records one stream.</h2>
		<p class="lede">
			A compositor decides the layout before you record and hands you one file afterwards. That
			is fine for a live stream, where the layout is the show.
		</p>
		<p>
			It is the wrong shape for a take you are going to cut. <a href="https://pteroprompter.com"
				>Pteroprompter</a
			> wanted the camera, the prompter screen, the microphone and the system audio as four files, started
			together, with no compositor in the way — so your edit could decide what goes where, and a scene
			change on the day would not be a decision baked into the footage.
		</p>
		<p>
			Rheocles is that. Arm what you want, cue once, and every armed stream lands as its own file
			with its own time-of-day timecode. The camera writes at native resolution and rate; the
			microphone writes Broadcast Wave; nothing is scaled, mixed or laid out on the way to disk.
		</p>
	</Section>

	<Section kicker="The distinction">
		<h2>It is not a compositor.</h2>
		<div class="table-scroll">
			<table>
				<thead>
					<tr><th></th><th>a compositor</th><th>Rheocles</th></tr>
				</thead>
				<tbody>
					<tr><td>Gives you</td><td>one file</td><td>one file per stream</td></tr>
					<tr><td>The layout is decided</td><td>before you record</td><td>in your edit</td></tr>
					<tr><td>Files sync</td><td>by eye</td><td>by timecode</td></tr>
					<tr><td>A crash leaves</td><td>a corrupt file</td><td>playable files and a truthful manifest</td></tr>
				</tbody>
			</table>
		</div>
		<p class="aside">
			If a composited stream <em>is</em> what you want, OBS is excellent and free, and you should use
			it. Rheocles is built around the moment after the take, not the moment during it.
		</p>
	</Section>

	<Section kicker="Arming">
		<h2>Armed means live.</h2>
		<p class="lede">
			An armed stream has its capture session running — frames flowing, discarded — so that when the
			cue comes, the writer starts on frames that already exist rather than waiting hundreds of
			milliseconds for a device to spin up. That is the entire reason there is an arm button.
		</p>
		<dl class="verbs">
			<div>
				<dt>arm / disarm</dt>
				<dd>Device live or not. Never stamps anything, never writes.</dd>
			</div>
			<div>
				<dt>join / leave</dt>
				<dd>
					While a take is active. <b>Join</b> starts that stream's writer now, adds its file to the
					manifest, and stamps it with the time it actually began. <b>Leave</b> finalises that file;
					the stream stays armed and the take continues for the others.
				</dd>
			</div>
			<div>
				<dt>the cue</dt>
				<dd>
					<code>start</code> on a take joins every armed stream at once. A stream that joins four
					minutes in is stamped four minutes in, and an editor places it at four minutes.
				</dd>
			</div>
		</dl>
		<div class="cards">
			<div class="card card--ochre">
				<h3>Armed costs you</h3>
				<p>
					Armed streams use CPU and hold their devices while armed. That is the trade, and the
					menu bar icon makes armed state obvious so nobody leaves six cameras live overnight by
					accident.
				</p>
			</div>
			<div class="card">
				<h3>Late joining is not a script</h3>
				<p>
					Late joining is for saving CPU on a heavy stream you already know will not need edit
					flexibility. It is not a way to script a take. Arm everything you might want, record,
					and cut in your edit; a script that toggles windows in and out of a take mid-read has
					misunderstood the tool.
				</p>
			</div>
		</div>
	</Section>

	<Section kicker="Timecode">
		<h2>Every file carries its own time.</h2>
		<p class="lede">
			A time-of-day timecode track in every video file. A Broadcast Wave time reference in every
			audio file. Both stamped from the host clock at the stream's first written frame.
		</p>
		<p>
			So the files sync in an editor without the manifest, and the manifest agrees with the files.
			Time-of-day rather than take-relative because it is the production standard: everything from
			one day shares a timeline, and two NTP-synced capture boxes produce files that line up —
			the remote scenario, solved as a side effect.
		</p>
		<p>
			<b>Drift is measured, not assumed.</b> Frames written × frame duration against host elapsed,
			per stream, in status events and in the manifest. An unmeasured drift is reported as absent,
			never as zero.
		</p>
		<p class="aside">
			<b>Midnight.</b> A stream that joins <em>after</em> midnight into a take that started before
			it gets a time-of-day reference near zero, and an editor syncing by timecode will place it
			before the take rather than after. Every camera and field recorder shares this; there is no
			clean fix inside the files. The manifest records absolute UTC and is unaffected, and is the
			authoritative source across midnight. Broadcast Wave files stop at 4 GB — many hours at 48
			kHz, 24-bit, and said here so it is not a surprise.
		</p>
	</Section>

	<Section kicker="The manifest">
		<h2>The manifest is the take.</h2>
		<p class="lede">
			<code>manifest.json</code> in the take folder, written at create and rewritten atomically —
			temp file, then rename — on every state change. At any instant it is either the previous
			complete version or the next. A dead process leaves playable files and a truthful manifest.
		</p>
		<Code code={manifest} lang="json" title="manifest.json — the shape docs/openapi.yaml pins" />
		<p class="aside">
			Everything downstream consumes the manifest; nothing guesses from a folder listing. Take IDs
			are the handle, paths are the answer, and every path is relative to the output root.
		</p>
	</Section>

	<Section kicker="The API in one glance">
		<h2>Create, cue, stop.</h2>
		<p class="lede">
			<code>POST /takes</code> reserves every file path and writes the manifest before frame one —
			so a client knows where the files will live. <code>start</code> is the cue.
		</p>
		<Code code={api} lang="sh" title="localhost:7447 — three calls, one take" />
		<Code code={events} lang="js" />
		<p class="aside">
			A bearer token, always, on every transport. It is provisioned to a file — mode 0600 — so any app
			running as you is paired with zero clicks; anything that cannot read the file gets it as a
			pairing code in the popover. Local only (for now): the threat is a web page in your
			browser talking to <code>localhost:7447</code>, and a token is the defence.
		</p>
	</Section>

	<Section kicker="The name">
		<h2>Known for the flow.</h2>
		<div class="name">
			<div class="name__text">
				<p class="name__greek" lang="grc">ῥέω</p>
				<p>
					<em>Rheō</em> is "to flow". It comes down from the Proto-Indo-European root{' '}
					<code>*srew-</code>, which came through Germanic as the English word <b>stream</b>. So{' '}
					<em>rheo-</em> does not resemble "stream"; it <em>is</em> "stream", two thousand years
					upstream.
				</p>
				<p>
					The <code>-cles</code> is <em>kleos</em>, renown — the same suffix as its sibling{' '}
					<a href="https://sonocles.com">Sonocles</a>. Known for the flow.
				</p>
				<p class="aside">
					Rhea, the Titaness, is attached to <em>rheō</em> by Plato, and Plato was making a pun.
					We are borrowing it, not asserting it. Both halves are Greek this time, which Sonocles
					could not say, and will hear about.
				</p>
			</div>
			<Plate
				name="Rhea and the stone"
				src={stonePlate}
				alt="Rhea hands a swaddled rock to a delighted Kronos, straight-faced. A small baby peeks out from behind her skirt."
				class="name__plate"
				caption="<strong>The stone.</strong> Kronos swallowed his children so there would only ever be one of him. Rhea handed him a rock in a blanket and kept the sixth one separate. Roughly our position on compositing."
			/>
		</div>
	</Section>

	<Section kicker="Anyway">
		<h2>Here is a Titaness<br />with a rig.</h2>
		<p class="lede">
			Six of them, each in their own cradle, all started on the same word. The one on the end
			arrived four minutes late and has been placed, correctly, four minutes in.
		</p>
		<Plate
			name="the rig"
			src={rigPlate}
			alt="Rhea reclines on a couch with a cup; six infants in a row of cradles each hold a small tablet. The sixth cradle sits a little apart on a green footstool, its baby waving."
			caption="<strong>Nobody in this picture is being swallowed.</strong> Which is, in fairness, the goal."
		/>
	</Section>
</Base>

<style>
	.hero {
		padding-block: 1.25rem 1rem;
		max-width: var(--page);
	}
	.hero__title {
		font-size: clamp(2.5rem, 7vw, 4.6rem);
		margin: 0.9rem 0 1.1rem;
	}
	.hero__accent {
		color: var(--aegean);
	}
	.hero__stand {
		font-size: 1.15rem;
		line-height: 1.5;
		max-width: 38rem;
	}
	.hero__stand strong {
		font-weight: 600;
	}
	/* A grid or flex item, so it must not stretch to the column. */
	.hero .pill {
		justify-self: start;
		align-self: flex-start;
		margin: 0;
	}
	/* Not a Plate: no caption, no box. A window floating over the page, so a
	   shadow and the popover's own corners are all it gets. */
	.hero__popover {
		display: block;
		width: 100%;
		max-width: 344px;
		height: auto;
		border-radius: 12px;
		box-shadow:
			0 1px 2px rgba(42, 33, 26, 0.12),
			0 12px 32px -8px rgba(42, 33, 26, 0.28);
	}

	/* Wide: a 55/45 split, copy in the first column, the popover in the
	   second spanning every row. The last row takes any height the popover
	   has over the copy, so the copy never spreads to match it. */
	@media (min-width: 761px) {
		.hero {
			display: grid;
			grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
			grid-template-rows: repeat(6, auto) 1fr;
			column-gap: 2.5rem;
			align-items: start;
		}
		.hero > * {
			grid-column: 1;
		}
		.hero__title {
			font-size: clamp(2.4rem, 4.2vw, 3rem);
		}
		/* Outranks the `.hero > *` column rule above. */
		.hero > .hero__popover {
			grid-column: 2;
			grid-row: 1 / span 7;
			justify-self: end;
			margin-top: 0.4rem;
		}
	}

	/* Wider still: the hero keeps the header's left edge and runs 220px past
	   its right, so the popover sits at its native width and the three
	   buttons fit on one row beside it. `left` is a visual shift only — the
	   box stays centred in flow — and the breakpoint is where the shifted
	   box still clears the viewport's edge by the gutter (24px at 1240). */
	@media (min-width: 1240px) {
		.hero {
			width: min(100% - 2 * var(--gutter), calc(var(--page) + 220px));
			max-width: none;
			position: relative;
			left: 110px;
			grid-template-columns: minmax(0, 1fr) 344px;
			column-gap: 3rem;
		}
		.hero__title {
			font-size: 3.2rem;
		}
	}

	/* Narrow: one column, and the popover moves up under the first paragraph
	   — pill, title, the what, the picture, then the rest. */
	@media (max-width: 760px) {
		.hero {
			display: flex;
			flex-direction: column;
		}
		.hero > * {
			order: 2;
		}
		.hero > .pill,
		.hero > .hero__title,
		.hero > .hero__stand--first {
			order: 1;
		}
		.hero > .hero__popover {
			order: 1;
			margin: 0.6rem auto 1.6rem;
		}
	}
	.hero__note {
		font-size: 0.95rem;
		color: var(--ink-faint);
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1.4rem;
	}
	.hero__platform {
		font-size: 0.8rem;
		color: var(--ink-faint);
		margin-left: 0.4rem;
	}
	.hero__platform a {
		color: inherit;
		font-family: var(--mono);
		text-decoration-color: color-mix(in oklab, var(--ink-faint) 40%, transparent);
	}
	.hero__brew {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: 1.2rem;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}
	.hero__brew span {
		color: var(--ink-faint);
	}
	.hero__brew code {
		font-size: 0.8rem;
		padding: 0.45em 0.8em;
		border-radius: 7px;
		background: var(--limestone-deep);
		color: var(--ink);
	}
	/* In the split the chip can be narrower than the command; the only place
	   it may break is the space between the two halves, never at the hyphen
	   in artisan-build. */
	.hero__brew code span {
		white-space: nowrap;
	}

	.aside {
		font-size: 0.92rem;
		color: var(--ink-soft);
		max-width: 40rem;
	}
	b {
		font-weight: 600;
	}

	.verbs {
		margin: 1.6rem 0 0;
		display: grid;
		gap: 0.2rem;
	}
	.verbs > div {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 1rem;
		padding: 0.85rem 0;
		border-top: 1px solid var(--limestone-line);
	}
	.verbs > div:last-child {
		border-bottom: 1px solid var(--limestone-line);
	}
	.verbs dt {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--aegean);
		padding-top: 0.15rem;
	}
	.verbs dd {
		margin: 0;
		font-size: 0.95rem;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
		margin-top: 1.8rem;
	}
	.card {
		background: var(--limestone-deep);
		border-radius: 12px;
		padding: 1.2rem 1.3rem 0.4rem;
		border-bottom: 3px solid var(--aegean);
	}
	.card--ochre {
		border-bottom-color: var(--ochre);
	}
	.card h3 {
		font-family: var(--sans);
		font-variation-settings: normal;
		font-weight: 600;
		font-size: 1rem;
		letter-spacing: 0;
		margin-bottom: 0.5rem;
	}
	.card p {
		font-size: 0.92rem;
		color: var(--ink-soft);
	}

	.name {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: start;
	}
	.name__greek {
		font-family: var(--display);
		font-variation-settings: 'SOFT' 30, 'WONK' 1;
		font-size: 2.2rem;
		color: var(--aegean);
		margin: 0 0 0.8rem;
	}
	.name__plate {
		margin-top: 0;
	}

	@media (max-width: 640px) {
		.verbs > div {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.3rem;
		}
		.name {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
