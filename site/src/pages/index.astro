---
// Landing page. Task 2 ships the hero so the placeholder on rheocles.com is
// replaced by something true; the sections follow in task 3.
import Base from '../layouts/Base.astro';
---

<Base
	title="Rheocles — every stream, its own file, on one cue"
	description="Rheocles records every camera, microphone, display and window on your Mac at once — each to its own file, started on one cue and stamped with time-of-day timecode. Free, open source, MIT."
>
	<section class="hero wrap wrap--wide">
		<p class="pill">Free · Open source · MIT</p>
		<h1 class="hero__title">
			Every stream, its own file,<br />
			<span class="hero__accent">on one cue.</span>
		</h1>
		<p class="hero__stand">
			Rheocles records every camera, microphone, display and window on your Mac at once — each to
			its own file, started on one cue and stamped with <strong>time-of-day timecode</strong>, so
			an editor syncs them in one click.
		</p>
		<p class="hero__stand">
			<strong>No compositor.</strong> The layout is a decision for the edit, not for the moment the
			light goes red. Arm what you might want, cue once, cut later.
		</p>
		<p class="hero__note">Loopback only. An HTTP and WebSocket API, one bearer token, zero clicks to pair.</p>
		<div class="hero__actions">
			<a class="button button--primary" href="/docs">Read the docs</a>
			<a class="button" href="https://github.com/artisan-build/rheocles">Source on GitHub</a>
			<span class="hero__platform">Apple Silicon · macOS 15 or later</span>
		</div>
		<p class="hero__brew">
			<span>coming soon</span>
			<code>brew install --cask artisan-build/tap/rheocles</code>
		</p>
	</section>
</Base>

<style>
	.hero {
		padding-block: 4.5rem 2rem;
		max-width: var(--page);
	}
	.hero__title {
		font-size: clamp(2.5rem, 7vw, 4.6rem);
		margin: 1.4rem 0 1.6rem;
	}
	.hero__accent {
		color: var(--aegean);
	}
	.hero__stand {
		font-size: 1.15rem;
		line-height: 1.5;
		max-width: 38rem;
	}
	.hero__stand strong {
		font-weight: 600;
	}
	.hero__note {
		font-size: 0.95rem;
		color: var(--ink-faint);
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1.8rem;
	}
	.hero__platform {
		font-size: 0.8rem;
		color: var(--ink-faint);
		margin-left: 0.4rem;
	}
	.hero__brew {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: 1.2rem;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}
	.hero__brew span {
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--script);
	}
	.hero__brew code {
		font-size: 0.8rem;
		padding: 0.45em 0.8em;
		border-radius: 7px;
		background: var(--limestone-deep);
		color: var(--script);
	}
</style>
