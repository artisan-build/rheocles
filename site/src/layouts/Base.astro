---
import '../styles/base.css';
import '../styles/code.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	// The social card's words. The image is fixed by the path — the landing
	// page's composed card at /og/index.png (source in ../../og.html), a
	// generated one for every other page (src/pages/og/[...slug].ts) — so
	// only the alt and the descriptions vary. Docs pages get their alt from
	// Docs.astro; the landing page describes the plate.
	card?: { alt: string; description?: string; twitterDescription?: string };
}
const { title, description, card } = Astro.props;
// build.format 'file' hands us /docs/markers.html at build time; the served
// URL is /docs/markers, and canonical and the card name must say that.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path, Astro.site);
// The social card for this page, generated by src/pages/og/[...slug].ts.
const ogSlug = path.replace(/^\/+|\/+$/g, '') || 'index';
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site);
const ogDescription = card?.description ?? description;
const twitterDescription = card?.twitterDescription ?? ogDescription;
const ogAlt = card?.alt ?? `Rheocles — ${title}`;
// The same request sonocles.com makes: one display face with its axes, one
// sans, one mono.
const fonts =
	'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400;9..144,500;9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Rheocles" />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={twitterDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogAlt} />
		<meta name="theme-color" content="#faf2e4" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={fonts} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
