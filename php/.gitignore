# --- Rheocles ---------------------------------------------------------------
# The core binary: a Swift build product that bin/sync-sidecar.sh copies in
# from app/.build. Rebuilt, never edited; the source is two directories up.
/extras/

# electron-builder and electron-vite output; the runtime's node_modules.
/nativephp/electron/dist/
/nativephp/electron/out/
/nativephp/electron/node_modules/

# The watcher's published daemon state and relaunch flag (storage/app is
# already ignored by Laravel's storage/*.key rule only; be explicit).
/storage/app/daemon.json
/storage/app/daemon.json.tmp
/storage/app/daemon.relaunch
